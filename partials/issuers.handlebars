<div id="issuer">
    {{#each issuers}}
        {{#if ../ksef_enabled}}
        <p style="font-weight: normal;font-style: italic;">{{{role}}}</p>
        {{/if}}
        <p style="font-weight: bold;">
            {{#and url ../show_links}}
                <a href="{{{url}}}" class="{{#eq ../../locale 'fr'}}incognito-link{{/eq}}">{{{name}}}</a>
            {{else}}
                {{{name}}}
            {{/and}}
        </p>
        <p>{{{address}}}</p>
        {{#if tax_no_with_kind }}
            <p>{{{tax_no_with_kind}}}</p>
        {{else}}
            <p>{{{tax_no}}}</p>
        {{/if}}
        {{#if address_note}}
            <p style="margin-top: 0.5em;" id="issuer_note">{{{address_note}}}</p>
        {{/if}}
        <br>
    {{/each}}
</div><!-- /issuers -->
